# Copy this file to `.env` for Docker Compose. It is intentionally ignored by Git:
# put provider credentials only in your local `.env`, never in a commit.
# NotedThat brings storage and search infrastructure; you bring an OpenAI-compatible
# embedding provider. Replace all four values below with that provider's details.
#
# See docs/CONFIGURATION.md for the full environment-variable reference.

# API bearer token. CHANGE THIS for anything beyond local dev.
NOTEDTHAT_API_TOKEN=dev-token-please-change

# Comma-separated KB slugs. Each must match [a-z0-9-]{1,40}.
NOTEDTHAT_KBS=notes,scratch

# Storage. The default Compose stack keeps objects on disk in the `notedthat-data`
# volume and runs no object store, so the three S3 values below are commented out.
#
# To run against SeaweedFS instead:
#   docker compose -f docker-compose.yml -f docker-compose.s3.yml up --build -d
# and uncomment them. Setting them while the `fs` backend is selected refuses startup
# rather than ignoring them — see docs/CONFIGURATION.md#storage-backend.

# S3 region (any value works for SeaweedFS; use the real region for AWS).
#NOTEDTHAT_S3_REGION=us-east-1

# S3 credentials (any value works for SeaweedFS; use real creds for AWS/MinIO).
#NOTEDTHAT_S3_ACCESS_KEY_ID=any
#NOTEDTHAT_S3_SECRET_ACCESS_KEY=any
# Compare each bucket against the search index at startup (objects changed by other
# tools get re-indexed). true or false; the on-demand pass is available either way.
#NOTEDTHAT_S3_RECONCILE=true

# Object change events. Off by default; the events route answers 404.
#
# `memory` needs nothing else and is right for this single-process stack:
#NOTEDTHAT_EVENTS_BACKEND=memory
#
# `nats` needs a JetStream broker — docker-compose.events.yml runs one and sets these
# on the server itself. Setting NOTEDTHAT_NATS_* while another events backend is
# selected refuses startup — see docs/CONFIGURATION.md#events-backend.
#NOTEDTHAT_NATS_STREAM=notedthat-events
#NOTEDTHAT_NATS_MAX_AGE_SECS=604800

# Log format: `pretty` (human-readable) or `json` (log aggregators).
NOTEDTHAT_LOG_FORMAT=pretty

# tracing-subscriber filter string.
RUST_LOG=info,notedthat=debug

# WebDAV basic-auth credentials. CHANGE THESE for anything beyond local dev.
NOTEDTHAT_WEBDAV_USERNAME=webdav-user-please-change
NOTEDTHAT_WEBDAV_PASSWORD=webdav-pass-please-change

# Maximum bytes accepted for PATCH. Default 100 MiB; must be <= 5 GiB.
NOTEDTHAT_MAX_PATCHABLE_SIZE=104857600

# How often /readyz probes storage and Qdrant, in ms; also each probe's deadline.
# An outage is reported within twice this value.
NOTEDTHAT_READY_PROBE_INTERVAL_MS=5000

# Compose uses the container's default temporary directory. To use a custom
# NOTEDTHAT_UPLOAD_TMP_DIR, add an explicit writable bind or named-volume mount
# at the same path under `notedthat-server` in a custom Compose deployment.

# Required embedding provider configuration. These examples are placeholders,
# not usable credentials: replace the endpoint, model, API key, and dimensions.
EMBEDDING_ENDPOINT_URL=https://your-embedding-provider.example/v1
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_API_KEY=replace-with-your-provider-key
EMBEDDING_DIMENSIONS=1536

# Embedding tuning defaults.
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_MAX_RETRIES=3
EMBEDDING_MAX_INPUT_TOKENS=8192

# Qdrant tuning defaults. The bundled local Qdrant service is unauthenticated,
# so do not set NOTEDTHAT_QDRANT_API_KEY in this file.
NOTEDTHAT_QDRANT_TIMEOUT_MS=30000
NOTEDTHAT_QDRANT_CONNECT_TIMEOUT_MS=10000

# MCP HTTP transport (always available at POST /mcp on NOTEDTHAT_LISTEN_ADDR)
# Empty NOTEDTHAT_MCP_HTTP_ALLOWED_ORIGINS is translated to ["null"] (loopback-only Origin),
# not passed to rmcp as allow-all. Set comma-separated values to restrict to specific origins.
NOTEDTHAT_MCP_HTTP_ALLOWED_ORIGINS=
# Empty NOTEDTHAT_MCP_HTTP_ALLOWED_HOSTS is translated to ["127.0.0.1","localhost","::1"]
# (loopback-only Host), not passed to rmcp as allow-all.
NOTEDTHAT_MCP_HTTP_ALLOWED_HOSTS=
# Whether POST /mcp admits a request with no credential: `auto` (yes, when a knowledge
# base's manifest grants `anyone` something; the tools then act as the anonymous caller)
# or `never` (always 401, so OAuth-capable clients are challenged on connect). Empty = auto.
NOTEDTHAT_MCP_ANONYMOUS=

# OIDC identity tokens (optional). Setting NOTEDTHAT_OIDC_ISSUER turns them on;
# the issuer is contacted at startup and must be spelled exactly as its `iss`
# claim. The audience is required with the issuer — usually the client id. The
# other five are optional and are refused if the issuer is unset. See
# docs/CONFIGURATION.md#oidc-authentication for Authentik, Authelia and Zitadel.
# NOTEDTHAT_OIDC_ISSUER=https://auth.example.com/application/o/notedthat/
# NOTEDTHAT_OIDC_AUDIENCE=notedthat
# NOTEDTHAT_OIDC_USERNAME_CLAIM=preferred_username
# NOTEDTHAT_OIDC_GROUPS_CLAIM=groups
# NOTEDTHAT_OIDC_HTTP_TIMEOUT_MS=5000
# NOTEDTHAT_OIDC_RESOURCE=https://notes.example.com
# NOTEDTHAT_OIDC_CA_CERT=/etc/notedthat/internal-ca.pem
